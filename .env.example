MPV_PATH=C:\mpv\mpv.exe
YTDLP_PATH=C:\mpv\yt-dlp.exe

OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=45
OLLAMA_KEEP_ALIVE=-1
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=180

MAX_QUEUE_SIZE=30
MAX_SEARCH_RESULTS=20
SEARCH_WORKERS=5

HOST=127.0.0.1
PORT=8888
AUTO_OPEN_BROWSER=1

# Optional. Leave empty to auto-detect.
OLLAMA_EXE=

FLASK_SECRET_KEY=change_this_to_a_random_local_secret
