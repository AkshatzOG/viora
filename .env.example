# Optional Viora settings. Copy this file to .env beside app.py before editing.
MPV_PATH=mpv\mpv.exe
YTDLP_PATH=mpv\yt-dlp.exe
HOST=127.0.0.1
PORT=8888
AUTO_OPEN_BROWSER=1
FLASK_SECRET_KEY=change-me-for-a-shared-machine
# Optional: set a custom data or download folder. By default Viora uses
# %LOCALAPPDATA%\Viora so source, PWA, and packaged builds share one profile.
# VIORA_DATA_DIR=
# VIORA_DOWNLOAD_DIR=
# External playlist links are saved inside Viora and do not need service API keys.
VIORA_DOWNLOAD_FORMAT=bestaudio/best
MAX_QUEUE_SIZE=30
MAX_SEARCH_RESULTS=20
SEARCH_WORKERS=5
SEARCH_CACHE_TTL=45
HOME_CACHE_TTL=90
AUTOPLAY_ENABLED=1
